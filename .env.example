# Copy this file to .env and fill in ONE of the two credential modes below.
# No key? No problem -- the app runs fully on a deterministic offline
# fallback and doesn't require a .env file to start.

# ---- Option A: Gemini Developer API (simplest for local dev) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Option B: Vertex AI (used in production / Cloud Run deploys) ----
# Leave GEMINI_API_KEY blank above and set these instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Optional ----
# Override the default Gemini model tier.
GEMINI_MODEL=gemini-2.5-flash-lite
